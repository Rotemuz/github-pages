<script>
// Global variables
let slideIndex = 0;
const allSlides = document.querySelectorAll('.slide');
const totalSlideCount = allSlides.length;

// Main slide display function
function displaySlide(index) {
    allSlides.forEach((slide, i) => {
        slide.classList.remove('active', 'prev');
        if (i === index) {
            slide.classList.add('active');
        } else if (i < index) {
            slide.classList.add('prev');
        }
    });
    document.getElementById('currentSlide').textContent = index + 1;
    
    // Handle demo animations
    handleSlideAnimations(index);
}

// Navigation functions
function nextSlide() {
    slideIndex = (slideIndex + 1) % totalSlideCount;
    displaySlide(slideIndex);
}

function previousSlide() {
    slideIndex = (slideIndex - 1 + totalSlideCount) % totalSlideCount;
    displaySlide(slideIndex);
}

// Keyboard navigation
document.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight' || event.key === ' ') nextSlide();
    if (event.key === 'ArrowLeft') previousSlide();
});

// Handle animations for specific slides
function handleSlideAnimations(index) {
    switch(index) {
        case 2:
            setTimeout(() => runElevatorDemo(), 1000);
            break;
        case 3:
            setTimeout(() => runEmergencyDemo(), 1000);
            break;
        case 4:
            setTimeout(() => runMunicipalDemo(), 1000);
            break;
    }
}

// Demo simulations
function runElevatorDemo() {
    const chatArea = document.getElementById('elevatorChat');
    const demoMessages = [
        {
            type: 'albert',
            text: '🚨 זיהיתי תקלת מעלית - טיקט #2851 נפתח<br>📞 המוקדנית שלנו תתקשר אליך תוך דקה<br>⚡ טכנאי יגיע תוך 15 דקות',
            delay: 2000
        },
        {
            type: 'albert', 
            text: '📢 עדכון לכל הדיירים:<br>מעלית ב\' תקועה זמנית<br>🔄 השתמשו במעלית א\' בינתיים<br>🔧 צפי תיקון: 30 דקות',
            delay: 4000
        },
        {
            type: 'user',
            text: 'וואו! המוקדנית כבר התקשרה ופתחה קריאת שירות. תודה Albert! 👏',
            delay: 6000
        }
    ];
    addChatMessages(chatArea, demoMessages, 'Albert - מנהל המבנה');
}

function runEmergencyDemo() {
    const chatArea = document.getElementById('emergencyChat');
    const demoMessages = [
        {
            type: 'albert',
            text: '📍 מרחבים מוגנים במבנה:<br>🏠 קומת מרתף - דלת ימין<br>🚗 חניון תת קרקעי - קיר מזרחי<br>🕐 זמינים 24/7',
            delay: 3000
        },
        {
            type: 'albert',
            text: '✅ ביטול התראה<br>🌅 חזרה לשגרה בטוחה<br>תודה שנשמרתם על ההוראות!',
            delay: 6000
        }
    ];
    addChatMessages(chatArea, demoMessages, 'Albert - מנהל המבנה');
}

function runMunicipalDemo() {
    const chatArea = document.getElementById('municipalChat');
    const demoMessages = [
        {
            type: 'user',
            text: 'מתי יחזרו המים? 💧',
            delay: 2000
        },
        {
            type: 'albert',
            text: '⏰ המים יחזרו בשעה 18:00 כמתוכנן<br>📱 קיבלתי עדכון ממקורות שהעבודות מתקדמות לפי לוח הזמנים<br>🚿 לחץ המים יחזור הדרגתי',
            delay: 4000
        }
    ];
    addChatMessages(chatArea, demoMessages, 'Albert - מנהל המבנה');
}

// Helper function to add messages to chat
function addChatMessages(chatArea, messages, albertName) {
    // Keep only the first message
    const firstMessage = chatArea.children[0];
    chatArea.innerHTML = '';
    chatArea.appendChild(firstMessage);

    messages.forEach((msg) => {
        setTimeout(() => {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${msg.type}`;
            
            let content = '';
            if (msg.type === 'albert') {
                content += `<div class="albert-indicator">${albertName}</div>`;
            }
            content += `<div class="message-bubble">${msg.text}</div>`;
            
            messageDiv.innerHTML = content;
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }, msg.delay);
    });
}

// Initialize presentation
displaySlide(0);
</script>
